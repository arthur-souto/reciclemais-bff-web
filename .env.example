PORT=3000

# Groq (IA usada na análise de evidências)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Postgres (usado pelo docker-compose e pela aplicação)
POSTGRES_DB=recicle_db
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# String de conexão usada pela aplicação e pelo drizzle-kit
DATABASE_URL=postgresql://dev:dev@localhost:5432/recicle_db

# JWT (usado para autenticação, assinatura RS256)
# Veja no README como gerar o par de chaves
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=1d
# Identificador (kid) da chave, exposto no header dos tokens e no JWKS (/.well-known/jwks.json)
JWT_KEY_ID=social-app-key-1

# Cloudflare R2 (usado para upload de imagens)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
